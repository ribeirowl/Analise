# football-data.org — cadastro grátis em https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# The Odds API — cadastro grátis em https://the-odds-api.com/#get-access
ODDS_API_KEY=
ODDS_API_REGIONS=eu,uk
ODDS_API_BOOKMAKERS=bet365,pinnacle,betfair_ex_eu

# Sofascore não precisa de key
SOFASCORE_USER_AGENT=Mozilla/5.0 (compatible; FutebolAnalise/1.0; educational)

# Servidor backend
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
